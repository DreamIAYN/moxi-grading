# 服务端密钥（可选）。页面中填写的密钥只保存在浏览器 localStorage，不会落盘。
DEEPSEEK_API_KEY=
BIGMODEL_API_KEY=
OPENCODE_API_KEY=
PORT=8787
# 可选：显式指定 xelatex 所在目录
# TEX_BIN=/home/you/texlive/2026/bin/x86_64-linux

# 用户登录会话签名密钥（生产环境请改成随机长字符串）
SESSION_SECRET=
# 超级管理员
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=
# 公网每个 IP 每小时批改次数；127.0.0.1/localhost 不受此限制
TRIAL_GRADES_PER_HOUR=8

# 可选：PDF 服务端渲染使用的 Python（需要 PyMuPDF）
PDF_RENDER_PYTHON=python3
